{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "incident-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "IncidentAgent",
        "class_name": "IncidentAgent"
      }
    ]
  },
  "workflows": [
    {
      "name": "investigation-workflow",
      "binding": "INVESTIGATION_WORKFLOW",
      "class_name": "InvestigationWorkflow"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "incident-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "incidents-index"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["IncidentAgent"]
    }
  ]
}
